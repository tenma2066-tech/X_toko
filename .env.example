# X (Twitter) アカウント情報 (twikit用 — APIキー不要・無料)
X_USERNAME=your_x_username
X_EMAIL=your_email@example.com
X_PASSWORD=your_password

# Database
# ローカル開発: sqlite+aiosqlite:///./x_toko.db
# Render:       postgresql+asyncpg://... (自動設定される)
DATABASE_URL=sqlite+aiosqlite:///./x_toko.db

# Application
SECRET_KEY=change-me-to-random-string
TZ=Asia/Tokyo
